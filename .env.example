# Open DART (https://opendart.fss.or.kr) API key
DART_API_KEY=
DART_API_BASE_URL=https://opendart.fss.or.kr/api

# Fallback SLM endpoint (OpenAI-compatible: Ollama / vLLM / OpenAI)
DART_LLM_BASE_URL=http://localhost:11434/v1
DART_LLM_API_KEY=ollama
DART_LLM_MODEL=qwen2.5:7b
DART_LLM_TIMEOUT=120
DART_LLM_ENABLED=true

# Local cache for downloaded documents
DART_CACHE_DIR=.cache
